{
  "name": "reporte-simple",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.18.0",
    "@cap-js/sqlite": "^3",
    "@types/node": "^24.0.0",
    "cds-plugin-ui5": "^0.17.0",
    "typescript": "~6.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "pacote": "^21.5.3",
    "sigstore": "^4.1.1",
    "@sigstore/core": "^3.2.1",
    "glob@>=9 <14.0.2": "^14.0.4",
    "minimatch@>=7 <11.0.1": "^11.0.8"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-conexiones": "CDS_TYPESCRIPT=false cds watch --open conexiones/index.html?sap-ui-xx-viewCache=false --livereload false",
    "test": "CDS_PLUGIN_UI5_ACTIVE=false node --test 'test/**/*.test.ts'",
    "lint": "npm run lint --workspaces --if-present",
    "pretest": "cds-typer '*' --outputDirectory @cds-models",
    "watch": "CDS_TYPESCRIPT=false cds watch",
    "pretest:mutacion": "cds-typer '*' --outputDirectory @cds-models",
    "test:mutacion": "node test/mutacion.ts",
    "build": "cds build --production"
  },
  "private": true,
  "cds": {
    "remote": {
      "native_fetch": false
    },
    "requires": {
      "ZMAKS_SB_CONEXIONES": {
        "kind": "odata",
        "model": "srv/external/ZMAKS_SB_CONEXIONES",
        "[production]": {
          "credentials": {
            "destination": "S4_BACKEND",
            "path": "/sap/opu/odata4/sap/zmaks_sb_conexiones/srvd/sap/zmaks_sd_conexiones/0001"
          }
        },
        "[hybrid]": {
          "credentials": {
            "destination": "S4_BACKEND",
            "path": "/sap/opu/odata4/sap/zmaks_sb_conexiones/srvd/sap/zmaks_sd_conexiones/0001"
          }
        }
      },
      "I_AIRPORT_STDVH": {
        "kind": "odata",
        "model": "srv/external/I_AIRPORT_STDVH",
        "[production]": {
          "credentials": {
            "destination": "S4_BACKEND",
            "path": "/sap/opu/odata4/sap/zmaks_sb_conexiones/srvd_f4/dmo/i_airport_stdvh/0001;ps='srvd-zmaks_sd_conexiones-0001';va='com.sap.gateway.srvd.zmaks_sd_conexiones.v0001.et-zmaks_i_conexiones.airportfromid'"
          }
        },
        "[hybrid]": {
          "credentials": {
            "destination": "S4_BACKEND",
            "path": "/sap/opu/odata4/sap/zmaks_sb_conexiones/srvd_f4/dmo/i_airport_stdvh/0001;ps='srvd-zmaks_sd_conexiones-0001';va='com.sap.gateway.srvd.zmaks_sd_conexiones.v0001.et-zmaks_i_conexiones.airportfromid'"
          }
        }
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "alice": {
              "roles": [
                "Visualizador"
              ]
            },
            "sinrol": {
              "roles": []
            }
          }
        },
        "[production]": {
          "kind": "xsuaa"
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/conexiones"
  ],
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  }
}
