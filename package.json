{
  "name": "reporte-simple",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.18.0",
    "@cap-js/sqlite": "^3",
    "@types/node": "^24.0.0",
    "cds-plugin-ui5": "^0.17.0",
    "typescript": "^7.0.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-conexiones": "CDS_TYPESCRIPT=false cds watch --open conexiones/index.html?sap-ui-xx-viewCache=false --livereload false",
    "test": "CDS_PLUGIN_UI5_ACTIVE=false node --test 'test/**/*.test.ts'",
    "pretest": "cds-typer '*' --outputDirectory @cds-models",
    "watch": "CDS_TYPESCRIPT=false cds watch"
  },
  "private": true,
  "cds": {
    "remote": {
      "native_fetch": false
    },
    "requires": {
      "ZMAKS_SB_CONEXIONES": {
        "kind": "odata",
        "model": "srv/external/ZMAKS_SB_CONEXIONES",
        "[production]": {
          "credentials": {
            "destination": "S4_BACKEND",
            "path": "/sap/opu/odata4/sap/zmaks_sb_conexiones/srvd/sap/zmaks_sd_conexiones/0001"
          }
        },
        "[hybrid]": {
          "credentials": {
            "destination": "S4_BACKEND",
            "path": "/sap/opu/odata4/sap/zmaks_sb_conexiones/srvd/sap/zmaks_sd_conexiones/0001"
          }
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/conexiones"
  ],
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  }
}
